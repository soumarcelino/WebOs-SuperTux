+#endif
 }
 
 const Controller&
@@ -59,6 +91,39 @@ void
 InputManager::update()
 {
   controller->update();
+#ifdef __linux__
+  for (int fd : m_remote_fds) {
+    input_event event;
+    while (read(fd, &event, sizeof(event)) == sizeof(event)) {
+      if (event.type != EV_KEY) continue;
+      SDL_Keycode key = SDLK_UNKNOWN;
+      switch (event.code) {
+        case KEY_PREVIOUS: // LG Back
+        case KEY_BACK:
+          key = SDLK_F17; break;
+        case KEY_RED: key = SDLK_F13; break;
+        case KEY_GREEN: key = SDLK_F14; break;
+        case KEY_YELLOW: key = SDLK_F15; break;
+        case KEY_BLUE: key = SDLK_F16; break;
+        case KEY_PLAY: key = SDLK_F18; break;
+        case KEY_PAUSE: key = SDLK_F19; break;
+        case KEY_REWIND: key = SDLK_F20; break;
+        case KEY_FASTFORWARD: key = SDLK_F21; break;
+        case BTN_LEFT: key = SDLK_F22; break; // Magic Remote pointer OK
+        case KEY_STOP: key = SDLK_F23; break;
+      }
+      if (key == SDLK_UNKNOWN) continue;
+
+      SDL_Event key_event = {};
+      key_event.type = event.value ? SDL_KEYDOWN : SDL_KEYUP;
+      key_event.key.state = event.value ? SDL_PRESSED : SDL_RELEASED;
+      key_event.key.repeat = event.value == 2;
+      key_event.key.keysym.sym = key;
+      key_event.key.keysym.scancode = SDL_GetScancodeFromKey(key);
+      SDL_PushEvent(&key_event);
+    }
+  }
+#endif
 }
 
